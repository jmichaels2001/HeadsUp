# Copy to .env.local and fill in. Never commit real values.
# Supabase → Project Settings → API Keys (use the new publishable/secret keys,
# not the legacy anon/service_role ones).

# Room backend: "server" (real rooms) or "mock" (Phase 1 single-tab mock).
# Defaults to "server" when NEXT_PUBLIC_SUPABASE_URL is set, otherwise "mock".
# "server" without Supabase uses an in-memory store (local dev only).
# NEXT_PUBLIC_ROOM_BACKEND=server

# Browser-safe: used only for Realtime pings and presence.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_...

# Live video (LiveKit Cloud → your project → Settings → API Keys). Server only:
# the URL is handed to players along with their token. Leave unset to play
# without video (tiles show placeholders).
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=API...
# LIVEKIT_API_SECRET=...

# Show the dev panel in production builds (on by default in local dev and
# on Vercel preview deploys).
# NEXT_PUBLIC_DEV_TOOLS=1

# Deck moderation at /admin (server only). Anyone who knows it can hide and
# delete decks. Leave unset to turn /admin off.
# ADMIN_SECRET=
