# Copy to .env.local and fill in. Never commit real values.
# Supabase → Project Settings → API Keys (use the new publishable/secret keys,
# not the legacy anon/service_role ones).

# Room backend: "server" (real rooms) or "mock" (Phase 1 single-tab mock).
# Defaults to "server" when NEXT_PUBLIC_SUPABASE_URL is set, otherwise "mock".
# "server" without Supabase uses an in-memory store (local dev only).
# NEXT_PUBLIC_ROOM_BACKEND=server

# Browser-safe: used only for Realtime pings and presence.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_...

# Show the dev panel in production builds (on by default in local dev and
# on Vercel preview deploys).
# NEXT_PUBLIC_DEV_TOOLS=1
